# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String
# Option 1: Local MongoDB (Default)
MONGO_URI=mongodb://127.0.0.1:27017/student_task_db
# Option 2: MongoDB Atlas Cloud (Uncomment and replace with your cluster URI)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/student_task_db?retryWrites=true&w=majority

# JWT Authentication Secret (Use a secure random string in production)
JWT_SECRET=super_secret_student_task_jwt_key_2026_internship_project

# JWT Expiration
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
